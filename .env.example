# ACS — ejemplo de variables (copia a .env y completa)
# Prisma Postgres — obtiene tu URL en prisma console o con `npx prisma postgres create`
DATABASE_URL="postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require"
DATABASE_URL_POOLED="postgres://USER:PASSWORD@pooled.db.prisma.io:5432/postgres?sslmode=require"
# Si usas Prisma Accelerate en prod:
# DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=..."

# OpenRouter tienda — https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-v1-..."
# OpenRouter admin (créditos separados del dueño; si se omite usa la de tienda)
# OPENROUTER_ADMIN_KEY="sk-or-v1-..."

# Admin único dueño de tienda (ACS)
ADMIN_EMAIL="admin@starshop.cl"
ADMIN_PASSWORD="StarShop2026!"
ADMIN_NAME="Dueño StarShop"
ADMIN_JWT_SECRET="cambia-esto-32-chars-min-en-prod"

# Opcional — URL pública para referer del agente
# NEXT_PUBLIC_APP_URL="https://tu-app.vercel.app"

# Voz (opcional)
# ELEVEN_API_KEY=sk_...
# ELEVEN_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# EDGE_TTS_VOICE=es-CL-CatalinaNeural
