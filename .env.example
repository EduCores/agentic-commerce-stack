# ACS — ejemplo de variables (copia a .env y completa)
# Prisma Postgres — obtiene tu URL en prisma console o con `npx prisma postgres create`
DATABASE_URL="postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require"
DATABASE_URL_POOLED="postgres://USER:PASSWORD@pooled.db.prisma.io:5432/postgres?sslmode=require"
# Si usas Prisma Accelerate en prod:
# DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=..."

# OpenRouter tienda — https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-v1-..."
# OpenRouter admin (créditos separados del dueño; si se omite usa la de tienda)
# OPENROUTER_ADMIN_KEY="sk-or-v1-..."

# Groq — plan gratuito: 1.000 requests/día POR MODELO, sin tarjeta ni créditos.
# Es la red de seguridad para demos/pruebas: el free de OpenRouter solo da 50/día.
# Consigue la key en https://console.groq.com/keys (registro gratuito).
# Modelos que usa la cadena: qwen/qwen3.8-27b, openai/gpt-oss-120b, openai/gpt-oss-20b.
# Si no la pones, la cadena funciona igual (solo usa OpenRouter).
# GROQ_API_KEY="gsk_..."

# Admin único dueño de tienda (ACS)
ADMIN_EMAIL="admin@starshop.cl"
ADMIN_PASSWORD="StarShop2026!"
ADMIN_NAME="Dueño StarShop"
ADMIN_JWT_SECRET="cambia-esto-32-chars-min-en-prod"

# Opcional — URL pública para referer del agente
# NEXT_PUBLIC_APP_URL="https://tu-app.vercel.app"

# WhatsApp separados: tienda (clientes) vs equipo (botón flotante del admin)
NEXT_PUBLIC_WHATSAPP_STORE="56993301557"
# NEXT_PUBLIC_WHATSAPP_TEAM="569XXXXXXXX"

# Demo visual — muestra gráficos y tablas con datos ficticios cuando la DB está vacía (para demos a clientes)
# Quítalo o ponlo en false antes de vender (el sistema volverá a 100% real)
# NEXT_PUBLIC_DEMO_MODE="true"

# Correos transaccionales (Resend) — sin RESEND_API_KEY los envíos se mockean (log + historial)
# RESEND_API_KEY="re_..."
# EMAIL_FROM="StarShop <noreply@starshop.cl>"
# Secreto del cron de correos (/api/cron/emails). Vercel lo envía solo en Authorization.
# CRON_SECRET="cambia-esto-en-produccion"

# Meta Ads — plug & play (Graph API v20.0). Sin conexión, /marketing usa mock para no romperse
# Se conecta desde /marketing (requiere login admin). No necesitas env, pero puedes prefijar:
# META_ACCESS_TOKEN="EAAx..."
# META_AD_ACCOUNT_ID="123456789012345"
# META_APP_ID="123..."
# META_PIXEL_ID="123..."

# Voz (opcional)
# ELEVEN_API_KEY=sk_...
# ELEVEN_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# EDGE_TTS_VOICE=es-CL-CatalinaNeural

# ── Protección del chat público (/api/chat y /api/chat/stream) ────────────────
# Orígenes adicionales permitidos (separados por coma). Por defecto se permiten:
#   https://starshop-rho.vercel.app, https://agentic-commerce-stack.vercel.app,
#   http://localhost:3000/3001/3002 y NEXT_PUBLIC_APP_URL.
# Las peticiones con Origin fuera de la lista se rechazan con 403.
# ALLOWED_ORIGINS="https://otra-tienda.vercel.app"
# Máx peticiones por IP y minuto (0 = ilimitado; default 30).
# CHAT_RATE_LIMIT_PER_MIN=30

# ── Slider del home (StarShop) ──────────────────────────────────────────────
# Origen público del frontend: resuelve rutas relativas de imagen (/b2b.jpg)
# y el enlace "Ver en la tienda" del panel /slider.
# Por defecto: https://starshop-rho.vercel.app
# STARSHOP_PUBLIC_ORIGIN=https://starshop-rho.vercel.app

